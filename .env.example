# Copie para .env.local. Valores locais do Supabase são impressos por `npx supabase status`.
# Nunca coloque segredos reais neste arquivo (ele vai para o Git).

# --- Supabase ---------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Somente servidor. Nunca exponha no cliente nem em logs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ambiente ---------------------------------------------------------------------------------
# local | hml | producao. Em "producao" o pagamento simulado fica sempre bloqueado.
APP_STAGE=local

# --- Pagamentos -------------------------------------------------------------------------------
# simulado (padrão, sem cobrança real) | asaas
PAYMENT_PROVIDER=simulado
# Libera o botão "Simular pagamento" fora do dev (só homologação). Nunca em produção.
ALLOW_SIMULATED_PAYMENTS=false
# Assina o webhook do provedor simulado fora do dev (mín. 16 caracteres).
SIMULATED_WEBHOOK_SECRET=

# Asaas (só com PAYMENT_PROVIDER=asaas). Chave de sandbox começa com $aact_hmlg_.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que o Asaas envia no webhook de cobranças/transferências (mín. 32 caracteres).
ASAAS_WEBHOOK_TOKEN=
# Token do "mecanismo de validação de saque" (Integrações → Mecanismos de segurança, mín. 32).
ASAAS_TRANSFER_VALIDATION_TOKEN=

# --- Rotina diária (Vercel Cron) --------------------------------------------------------------
# Bearer exigido por /api/cron/conciliar (mín. 16 caracteres).
CRON_SECRET=

# --- E-mail (Resend) --------------------------------------------------------------------------
# Sem a chave, as notificações ficam na fila e não são enviadas.
RESEND_API_KEY=
EMAIL_FROM="Secretfans <nao-responda@secretfans.app.br>"

# --- Rate limit (Upstash Redis) ---------------------------------------------------------------
# Sem estas variáveis o limite fica em memória (só serve para dev / instância única).
# A integração da Vercel cria KV_REST_API_URL e KV_REST_API_TOKEN (também aceitos).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
