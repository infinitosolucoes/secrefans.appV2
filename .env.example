# Copie para .env.local. Valores locais são impressos por `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Somente servidor. Nunca exponha no cliente nem em logs.
SUPABASE_SERVICE_ROLE_KEY=
# Bot de moderação do Telegram (opcional). O token NUNCA vai em commit nem em chat.
# Passo a passo em docs/runbooks/telegram-bot.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
